f## Section 5: the graph of Figure 7, with c-degree 2, after merging U1 and U3.
## First district {V1, V3, V6}: 8 flagged constraints, all trivial in observed terms.
## Second district {V2, V4, V5}: 1118 flagged constraints, and a strictly positive
## distribution that satisfies all equality constraints but violates 13 inequalities.
source("common.R")

g  <- dhvm(caugi(V1 %-->% V2 + V6, V2 %-->% V3, V3 %-->% V4, V4 %-->% V5, V6 %-->% V3,
                 U1 %-->% V2 + V4, U2 %-->% V1 + V3 + V6, U3 %-->% V4 + V5))
print(dhvm_c_degree(g))
gm <- dhvm_merge_latents(g)
cn <- meraconstraints(gm)
print(cn)

d1 <- grep("V1", names(cn$polytope$Hrep))[1]
section("First district: flagged constraints, in terms of interventional probabilities")
cat(constraint_text(cn, d1, star = TRUE), sep = "\n")
section("... and in terms of observed probabilities")
cat(constraint_text(cn, d1), sep = "\n")

## Example distribution: every variable except V4 takes the value 1 with probability 1/2
## given its parents, and P(V4 = v4 | V1, V2, V3) = 1/8 + (3/4) a(V1, V2, V3, v4), where
## a = (1 - V1*V3) * 1{V2 == v4} + V1*V3 * 1{V2 != v4}.
pt <- data.table(expand.grid(V1 = 0:1, V2 = 0:1, V3 = 0:1, V4 = 0:1, V5 = 0:1, V6 = 0:1))
pt[, a := (1 - V1 * V3) * (V2 == V4) + V1 * V3 * (V2 != V4)]
pt[, joint := (1/2)^5 * (1/8 + (3/4) * a)]
cat("\nSum of probabilities:", sum(pt$joint), "  smallest probability:", MASS::fractions(min(pt$joint)), "\n")

## District factor of {V2, V4, V5}: P(v2 | v1) P(v4 | v1, v2, v3) P(v5 | v1, v2, v3, v4)
pt[, p1 := sum(joint), by = V1]
pt[, p12 := sum(joint), by = .(V1, V2)]
pt[, p123 := sum(joint), by = .(V1, V2, V3)]
pt[, p1234 := sum(joint), by = .(V1, V2, V3, V4)]
pt[, p12345 := sum(joint), by = .(V1, V2, V3, V4, V5)]
pt[, pstar := (p12 / p1) * (p1234 / p123) * (p12345 / p1234)]
cat("Left side of the inequality of Clauser et al.:",
    unique(pt[, .(V1, V2, V3, V4, V5, a, pstar)])[, sum(a * pstar)], "(bound 3)\n")

d2  <- grep("V2", names(cn$polytope$Hrep))[1]
H   <- cn$polytope$Hrep[[d2]]
pv  <- merge(cn$functional_relations$problevels[[d2]], unique(pt[, .(V1, V2, V3, V4, V5, pstar)]), sort = FALSE)$pstar
ok  <- hrep_test(H, pv, which = TRUE)
cat("Equality constraints satisfied:", all(ok[H[, 1] == 1]), "\n")
cat("Inequality constraints violated:", sum(!ok), "\n")
txt <- hrep_to_text(H, cn$functional_relations$probstarform[[d2]])[!ok]
section("Shortest violated constraint (as printed in Section 5)")
cat(txt[which.min(nchar(txt))], "\n")
